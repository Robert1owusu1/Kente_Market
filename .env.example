# ============================================
# FRONTEND ENVIRONMENT VARIABLES (copy to .env in the project ROOT)
# ============================================

# Where the backend API lives.
# Leave EMPTY for local dev: requests go through the Vite proxy
# (/api -> http://localhost:5000) so cookies stay on localhost.
# Set to e.g. https://api.yourdomain.com for production.
VITE_API_URL=

# Paystack PUBLIC (pk_test_...) key. Public keys are safe in the browser.
# Test key from https://dashboard.paystack.com/#/settings/developers
VITE_PAYSTACK_PUBLIC_KEY=