{
  "name": "backend",
  "version": "1.0.0",
  "description": "e-commerce backend",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "setup-admin": "node setupFirstAdmin.js",
    "db:setup": "node setupDB.js",
    "db:migrate": "node migrateNewTables.js && node migrateMarketplace.js",
    "email:test": "node test-email.js",
    "password:reset:test": "node test-password-reset.js",
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "node --test \"tests/**/*.test.js\"",
    "test:unit": "node --test tests/money.test.js tests/escrowLogic.test.js",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "keywords": [
    "ecommerce",
    "paystack",
    "api"
  ],
  "author": "Robert",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.12.2",
    "bcryptjs": "^3.0.2",
    "colors": "^1.4.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "express-async-handler": "^1.2.0",
    "express-mysql-session": "^3.0.3",
    "express-rate-limit": "^8.2.1",
    "express-session": "^1.18.2",
    "helmet": "^8.1.0",
    "hpp": "^0.2.3",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "mysql2": "^3.15.0",
    "node-cache": "^5.1.2",
    "nodemailer": "^9.1.1",
    "passport": "^0.7.0",
    "passport-facebook": "^3.0.0",
    "passport-google-oauth20": "^2.0.0",
    "replicate": "^1.4.0"
  },
  "devDependencies": {
    "@types/colors": "^1.2.4",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.4.1",
    "nodemon": "^3.1.10"
  }
