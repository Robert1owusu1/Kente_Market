# ============================================================
# Kente Market — backend environment template
# Copy to backend/.env and fill in real values.
#   cp .env.example .env
# NEVER commit .env. Placeholder values here are example-only.
# Run the DB migration first:  npm run db:migrate --prefix backend
# ============================================================

# --- Runtime ---------------------------------------------------------------
NODE_ENV=development                 # development | production
PORT=5000
FRONTEND_URL=http://localhost:5173   # exact frontend origin (CSRF/session/redirects)
TRUST_PROXY=0                        # 0..3 hops; set >=1 only when behind a reverse proxy
LOG_FORMAT=dev                       # dev | combined | json

# --- Error tracking (optional but recommended in production) ----------------
# Create a backend project in Sentry and paste its DSN here.
SENTRY_DSN=
SENTRY_ENVIRONMENT=                  # defaults to NODE_ENV
SENTRY_RELEASE=                      # optional deploy/version identifier
SENTRY_TRACES_SAMPLE_RATE=0.1        # 0..1; lower this for high traffic

# --- Prometheus scraping ----------------------------------------------------
# X4a: /metrics used to be public. Leave empty (or unset) to keep it closed —
# the route then answers 404 as if it did not exist. Set a long random value
# to expose it, and scrape with:  curl -H "x-metrics-token: $METRICS_TOKEN"
METRICS_TOKEN=

# --- Database (MySQL) ------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=change-me
DB_NAME=kente_market
DB_SSL=0                             # 0 off | 1 TLS w/o CA verify (see DB_SSL_CA)
DB_SSL_CA=                           # path to CA cert for verified TLS (production)

# --- Security ---------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change-me-48-byte-random-hex
JWT_SECRET=change-me-48-byte-random-hex
COOKIE_SAME_SITE=lax                 # lax | strict | none
OAUTH_CALLBACK_URL=http://localhost:5000   # absolute backend origin for OAuth callbacks

# --- Paystack ---------------------------------------------------------------
# Test-mode secret key (sk_test_...). NEVER a live key, and never a real one in
# this file: this is an EXAMPLE, and git history already carries one key that
# was pasted here by mistake (see .gitleaksignore / the red-team report — rotate
# it if the sandbox account still matters). CI's secret scan rejects key-shaped
# values in this file.
PAYSTACK_SECRET_KEY=sk_test_REPLACE_WITH_YOUR_OWN_TEST_KEY

# --- OAuth providers (optional) --------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# --- Email (optional; used for OTP / notifications) -------------------------
ENABLE_EMAIL=false
EMAIL_SERVICE=
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM="Kente Market <no-reply@example.com>"

# --- AI / Replicate Try-On (optional) --------------------------------------
# The feature is off unless BOTH are set: the flag is compared literally to
# 'true' (an unset or 'false' value keeps try-on disabled).
AI_TRYON_ENABLED=false
REPLICATE_API_TOKEN=
# Comma-separated hostnames that image URLs may point at. Required the moment
# anything other than a data: URI is used — with this empty (the default) NO
# https image host is accepted, by design. Replicate downloads these URLs from
# its own network position, so this host list is the only thing standing
# between a caller and delegated SSRF: a syntactic check cannot tell
# https://localtest.me/ from a real CDN, and resolving it here would not help
# because Replicate resolves it again, elsewhere, later.
# Whole hostnames only — no wildcards, no suffix matching, default port only.
AI_TRYON_ALLOWED_HOSTS=

# --- Platform business tuning ----------------------------------------------
PLATFORM_FEE_RATE=0.1                # platform commission (0.10 = 10%)
ESCROW_RELEASE_DAYS=7                # order escrow release window (days)
CUSTOM_ADVANCE_RATIO=0.5             # custom-order advance payout ratio
AI_TRYON_DAILY_LIMIT=10              # AI Try-On requests per user per day
MAX_OTP_ATTEMPTS=5                   # failed OTP attempts before lockout
OTP_EXPIRY_MINUTES=10
CART_RECOVERY_COOLDOWN_HOURS=24

# --- Uploads storage backend ------------------------------------------------
# Only 'local' is implemented (backend/uploads — survives on any single-host
# deployment, wiped on ephemeral hosts). Any other value makes the app EXIT at
# boot instead of silently writing to disk. See .deploy/UPLOADS_OBJECT_STORAGE.md
# for the S3-compatible switch plan (set STORAGE_BACKEND=s3 + S3_BUCKET/KEY/...).
STORAGE_BACKEND=local

# --- Encrypted DB backups (.deploy/backup-db.sh) ------------------------------
# Daily + before every migration: npm run db:backup --prefix backend
BACKUP_DIR=$HOME/.kente-backups        # OUTSIDE the repo / ephemeral disk
BACKUP_PASSPHRASE=change-me-32-plus-chars   # AES-256-CBC (openssl); or use:
# BACKUP_GPG_KEY_ID=                    # alternative: public-key encryption
BACKUP_RETENTION=35                     # encrypted copies kept (daily defaults)
BACKUP_UPLOADS=0                        # set 1 to also archive backend/uploads

# ============================================================
# Production checklist (see PRODUCTION_HARDENING_AUDIT.md)
#  - NODE_ENV=production, TRUST_PROXY set for your proxy, HTTPS only
#  - SESSION_SECRET + JWT_SECRET = long random hex, unique per environment
#  - PAYSTACK_SECRET_KEY = live key, payouts kept disabled until the
#    settlement / reversal / ledger / reconciliation suite is validated
# ============================================================