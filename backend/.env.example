# ============================================================
# Kente Market — backend environment template
# Copy to backend/.env and fill in real values.
#   cp .env.example .env
# NEVER commit .env. Placeholder values here are example-only.
# Run the DB migration first:  npm run db:migrate --prefix backend
# ============================================================

# --- Runtime ---------------------------------------------------------------
NODE_ENV=development                 # development | production
PORT=5000
# Comma-separated list of allowed frontend ORIGINS (no path, no trailing slash).
# Every entry is allowed by CORS/CSRF; the FIRST entry is the canonical site used
# for emailed links, OAuth and Paystack redirects and referral links. Production
# boot refuses anything that is not a bare https origin (http only for localhost).
FRONTEND_URL=http://localhost:5173
TRUST_PROXY=0                        # 0..3 hops; set >=1 only when behind a reverse proxy
LOG_FORMAT=dev                       # dev | combined | json

# --- Error tracking (optional but recommended in production) ----------------
# Create a backend project in Sentry and paste its DSN here.
SENTRY_DSN=
SENTRY_ENVIRONMENT=                  # defaults to NODE_ENV
SENTRY_RELEASE=                      # optional deploy/version identifier
SENTRY_TRACES_SAMPLE_RATE=0.1        # 0..1; lower this for high traffic

# --- Prometheus scraping ----------------------------------------------------
# X4a: /metrics used to be public. Leave empty (or unset) to keep it closed —
# the route then answers 404 as if it did not exist. Set a long random value
# to expose it, and scrape with:  curl -H "x-metrics-token: $METRICS_TOKEN"
METRICS_TOKEN=

# --- Database (MySQL) ------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=change-me
DB_NAME=kente_market
DB_SSL=0                             # 0 off | 1 TLS w/o CA verify (see DB_SSL_CA)
DB_SSL_CA=                           # path to CA cert for verified TLS (production)
# Production with DB_SSL=1 and no readable DB_SSL_CA refuses to boot unless this
# is 1 (unverified TLS). Prefer a CA bundle (e.g. the host's system bundle).
DB_SSL_ALLOW_UNVERIFIED=
DB_POOL_SIZE=10                      # mysql2 pool size (1..50)
DB_WARM_CONNECTIONS=4                # connections opened at boot (<=10)

# --- Security ---------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change-me-48-byte-random-hex
JWT_SECRET=change-me-48-byte-random-hex
COOKIE_SAME_SITE=lax                 # lax | strict | none
# ORIGIN only — the code appends /api/auth/google/callback. Behind the Vercel
# rewrite this is the frontend origin; register <origin>/api/auth/google/callback
# in the Google console.
OAUTH_CALLBACK_URL=http://localhost:5000

# --- Paystack ---------------------------------------------------------------
# Test-mode secret key (sk_test_...). NEVER a live key, and never a real one in
# this file: this is an EXAMPLE, and git history already carries one key that
# was pasted here by mistake (see .gitleaksignore / the red-team report — rotate
# it if the sandbox account still matters). CI's secret scan rejects key-shaped
# values in this file.
PAYSTACK_SECRET_KEY=sk_test_REPLACE_WITH_YOUR_OWN_TEST_KEY

# --- OAuth providers (optional) --------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# --- Email (optional; used for OTP / notifications) -------------------------
ENABLE_EMAIL=false
EMAIL_SERVICE=
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM="Kente Market <no-reply@example.com>"
# Generic SMTP relay instead of EMAIL_SERVICE (opt-in): host, port, TLS.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_SECURE=false
# 1 = never send mail (test/staging sandboxes). Never set in production.
EMAIL_DISABLED=

# --- AI Virtual Try-On (optional) -----------------------------------------
# Full guide: AI_TRYON_PROVIDER_SETUP.md. New try-on jobs are accepted only
# when ALL of these hold: AI_TRYON_ENABLED is literally 'true', a known
# AI_TRYON_PROVIDER is set, and that provider's configuration checks pass
# (in production also AI_TRYON_PROVIDER_TERMS_ACCEPTED, see below). Setting
# AI_TRYON_ENABLED=false is the kill switch: new jobs stop immediately,
# existing jobs still finish and results stay viewable until they expire.
AI_TRYON_ENABLED=false
# Adapter id: fashn (recommended, FASHN Try-On Max) | replicate-idm-vton |
# mock (mock = development only, NOT AI;
# refused when NODE_ENV=production). No default: unset means "not configured".
AI_TRYON_PROVIDER=
# Provider API key. Backend only — never put it in a VITE_* variable.
# (REPLICATE_API_TOKEN is still read as a fallback for older deployments.)
AI_TRYON_API_KEY=
# Optional override of the provider API base URL (https only). Leave empty to
# use the adapter default (fashn: https://api.fashn.ai/v1;
# replicate-idm-vton: https://api.replicate.com/v1).
AI_TRYON_API_BASE_URL=
# Optional model version (fashn: empty or tryon-max; replicate-idm-vton:
# 64-hex version id). Empty = the adapter default.
AI_TRYON_MODEL_VERSION=
# fashn only: fast | balanced | quality. Cost per image at 1k resolution:
# 1 / 2 / 3 credits. Empty = fast (cheapest).
AI_TRYON_GENERATION_MODE=
# Optional webhooks (replicate-idm-vton only; FASHN does not sign webhooks,
# so the fashn adapter never uses them and completes jobs by polling). Needs BOTH the signing
# secret (whsec_..., from GET https://api.replicate.com/v1/webhooks/default/secret)
# and the public https origin of THIS API. Without them, jobs complete by
# polling (customer polling + the sweepTryOnJobs scheduler), which is enough.
AI_TRYON_WEBHOOK_SECRET=
AI_TRYON_PUBLIC_API_URL=
# Production gate: the configured model's licence must permit commercial use.
# IDM-VTON is CC BY-NC-SA 4.0 (non-commercial). Set 'true' ONLY after you hold
# terms (licence + provider ToS) that permit commercial use.
AI_TRYON_PROVIDER_TERMS_ACCEPTED=false
# Comma-separated hostnames that REMOTE CATALOG images may point at. Client
# callers can never supply image URLs (the photo must be an inline upload and
# the garment is resolved server-side from the product row), so this list only
# vouches for product images stored on a remote host (e.g. an S3/R2 public
# bucket) that `product.img` references with an absolute https URL. Relative
# paths (/images/..., /uploads/...) are read from local storage and never
# touch this list. Empty (the default) means "no remote image host is
# fetchable"; such products show as "try-on unavailable".
# Whole hostnames only — no wildcards, no suffix matching, default port only.
AI_TRYON_ALLOWED_HOSTS=
# Cost controls. Daily spend per user: AI_TRYON_DAILY_LIMIT (below). These cap
# SIMULTANEOUS active jobs per user and in total.
AI_TRYON_MAX_ACTIVE_PER_USER=2
AI_TRYON_MAX_ACTIVE_GLOBAL=8
# A job still unfinished after this many minutes is stopped and cancelled at
# the provider (2-30; also sent to the provider as Cancel-After).
AI_TRYON_JOB_TIMEOUT_MINUTES=10
# How long a finished try-on image is kept for its owner (1-168 hours), and
# how long photo-free job metadata is kept after a job ends (1-365 days).
AI_TRYON_RESULT_TTL_HOURS=24
AI_TRYON_JOB_RETENTION_DAYS=30
# Private directory for result images (must NOT be under uploads/). Empty =
# backend/private/tryon-results. Use a persistent disk in production.
AI_TRYON_RESULT_DIR=

# --- Delivery fees & exchange rates ------------------------------------------
# Delivery fees are set in the app: Admin -> Shipping & FX (platform default per
# country) and Seller dashboard -> Shipping (a seller's own fee, which replaces
# the default for their products). Each seller's parcel is charged separately.
# Fees set in GBP/USD/CAD/EUR are converted to cedis with rates fetched
# automatically twice a day from ExchangeRate-API's open endpoint (no key;
# attribution link shown at checkout). Off when NODE_ENV=test.
FX_AUTO_UPDATE=true                  # false = never fetch (last stored rates stay in use)
FX_RATES_URL=                        # https override; default https://open.er-api.com/v6/latest/GHS
FX_MAX_DAILY_CHANGE=0.25             # refuse a rate that moved more than this fraction in one update

# --- Platform business tuning ----------------------------------------------
PLATFORM_FEE_RATE=0.1                # platform commission (0.10 = 10%)
ESCROW_RELEASE_DAYS=7                # order escrow release window (days)
CUSTOM_ADVANCE_RATIO=0.5             # custom-order advance payout ratio
AI_TRYON_DAILY_LIMIT=10              # AI Try-On requests per user per day
MAX_OTP_ATTEMPTS=5                   # failed OTP attempts before lockout
OTP_EXPIRY_MINUTES=10
CART_RECOVERY_COOLDOWN_HOURS=24

# --- Uploads storage backend ------------------------------------------------
# 'local' (default): backend/uploads — needs a persistent disk; wiped on
#   ephemeral hosts (e.g. Render without a disk) at every deploy.
# 's3': any S3-compatible store (AWS S3, Cloudflare R2, MinIO, B2, Wasabi,
#   Spaces) for product, reference and profile images. Any other value makes the
#   app EXIT at boot. See .deploy/UPLOADS_OBJECT_STORAGE.md.
STORAGE_BACKEND=local
S3_ENDPOINT=                         # e.g. https://<account>.r2.cloudflarestorage.com
S3_BUCKET=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PATH_STYLE=true                   # false = virtual-hosted bucket URLs
S3_PUBLIC_BASE_URL=                  # public bucket domain, e.g. https://media.yourdomain.com (REQUIRED in production)
S3_TIMEOUT_MS=30000                  # per-request deadline to the bucket
# With R2, product image URLs are absolute (S3_PUBLIC_BASE_URL/...): add that
# host to AI_TRYON_ALLOWED_HOSTS or try-on reports those products unavailable.

# --- Redis (optional) -----------------------------------------------------------
# Shared store for rate limits across replicas. Unset = in-memory limits
# (per process). Use a TLS URL (rediss://) for hosted Redis.
REDIS_URL=

# --- Rate limiting (optional) -----------------------------------------------------
API_RATE_LIMIT_MAX=                  # global /api requests per window per client; blank = code default

# --- Payment recovery job batch sizes (optional) --------------------------------
# Upper bound on orders examined per run. Defaults are safe; raise only if the
# scheduler logs "batch limit reached" repeatedly.
# recoverIncompletePaidOrders (every 15 min, tracked paid orders only):
PAID_EFFECTS_RECOVERY_BATCH=50
# recoverStuckPendingOrders (every 30 min, pending orders 1h..7d old; one
# Paystack verify call per order):
STUCK_PENDING_RECOVERY_BATCH=100

# --- Encrypted DB backups (.deploy/backup-db.sh) ------------------------------
# Daily + before every migration: npm run db:backup --prefix backend
BACKUP_DIR=$HOME/.kente-backups        # OUTSIDE the repo / ephemeral disk
BACKUP_PASSPHRASE=change-me-32-plus-chars   # AES-256-CBC (openssl); or use:
# BACKUP_GPG_KEY_ID=                    # alternative: public-key encryption
BACKUP_RETENTION=35                     # encrypted copies kept (daily defaults)
BACKUP_UPLOADS=0                        # set 1 to also archive backend/uploads

# --- Seed script only (npm run data:import) — never set on a server -----------------
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# ============================================================
# Production checklist (see PRODUCTION_HARDENING_AUDIT.md)
#  - NODE_ENV=production, TRUST_PROXY set for your proxy, HTTPS only
#  - SESSION_SECRET + JWT_SECRET = long random hex, unique per environment
#  - PAYSTACK_SECRET_KEY = live key, payouts kept disabled until the
#    settlement / reversal / ledger / reconciliation suite is validated
# ============================================================