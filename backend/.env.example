# ============================================
# BACKEND ENVIRONMENT VARIABLES (copy to backend/.env)
# ============================================

# --- App ---
# development = local dev (cookies not forced to HTTPS, CORS allows any origin)
NODE_ENV=development
PORT=5000
# How many reverse-proxy hops to trust so req.ip (rate limiting) is correct.
#   1 = one proxy (Vite dev proxy / a single Nginx)  [RECOMMENDED default]
# Increase only if you run multiple proxies in front of Express.
TRUST_PROXY=1

#Database (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=branding_house

# --- Authentication Secrets ---
# Generate strong values:
#   openssl rand -hex 64
JWT_SECRET=generate_with_openssl_rand_-hex_64
SESSION_SECRET=generate_with_openssl_rand_-hex_64

# --- Frontend / OAuth URLs ---
# For local development run `npm run dev` (Vite default port = 5173). The
# Google redirect URI must match the dev origin. `npm start` serves the
# production build (vite preview) on port 3000 — fine for browsing, but the
# "Sign in with Google" button only works when the frontend runs on 5173.
FRONTEND_URL=http://localhost:5173
# Must match the backend origin (used to build OAuth callback URLs)
OAUTH_CALLBACK_URL=http://localhost:5000

# --- OAuth (Google) ---
# STEP-BY-STEP SETUP for "Sign in with Google":
#   1. Go to https://console.cloud.google.com/ and create (or open) a project.
#   2. Top-left menu -> "APIs & Services" -> "OAuth consent screen".
#        - User type: External (keep "Test" mode is fine for development).
#        - Fill the app name + support email, click Save.
#   3. "APIs & Services" -> "Credentials" -> "+ Create Credentials"
#        -> "OAuth client ID".
#        - Application type: "Web application".
#        - Authorized JavaScript origins: add BOTH:
#            http://localhost:5173
#            http://localhost:5000
#        - Authorized redirect URI: add EXACTLY this:
#            http://localhost:5000/api/auth/google/callback
#        - Click Create.
#   4. Copy the Client ID and Client Secret into the two lines below.
#   5. Keep the "Test" consent screen and add your own Google account as a
#      test user, OR click "Publish app" to allow any Google account.
#   6. Restart the backend (cd backend && npm run dev).
# Leave these blank to disable Google sign-in. The Login page builds the
# callback URL from OAUTH_CALLBACK_URL above, so keep that value as is.
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# --- OAuth (Facebook) — OPTIONAL ---
# Leave blank to disable Facebook sign-in (backend logs a warning at boot).
# App credentials from https://developers.facebook.com/apps
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=



# --- Email (Nodemailer) ---
# STEP-BY-STEP SETUP (required for password reset AND email verification):
#   1. Sign in to the Gmail account you want to send mail FROM (the address
#      you'll put in EMAIL_USER). It needs 2-Step Verification ENABLED.
#   2. Go to https://myaccount.google.com/apppasswords
#      (or Google Account -> Security -> "App passwords").
#   3. Create an app password: App = "Mail" (or "Other"), it gives you a
#      16-character code like:  jmub axay qfnx ttwn
#   4. Put your Gmail ADDRESS into EMAIL_USER and the 16-char app password
#      into EMAIL_PASSWORD below (remove any spaces).
#   5. Restart the backend (cd backend && npm run dev).
# NOTE: EMAIL_PASSWORD is an APP PASSWORD, not your normal login password.
EMAIL_SERVICE=gmail
EMAIL_USER=kenterobert@gmail.com
EMAIL_PASSWORD=your_gmail_app_password
EMAIL_FROM=Bonwire Kente <your_email@gmail.com>
OTP_EXPIRY_MINUTES=10
MAX_OTP_ATTEMPTS=5

# --- Payments: Paystack ---
# Test (sk_) key from https://dashboard.paystack.com/#/settings/developers
# Production is pk_/sk_live_... Never commit the live key.
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Escrow / Payout configuration ---
# PLATFORM_FEE_RATE: default % the platform takes from each vendor payout
#   (0.1 = 10%). Used when a vendor has not been assigned their own fee rate.
PLATFORM_FEE_RATE=0.1
# ESCROW_RELEASE_DAYS: auto-release to vendors this many days after an order is
#   delivered and payment is held (used by the escrow scheduler).
ESCROW_RELEASE_DAYS=7

# --- AI Try-On (Replicate / IDM-VTON) ---
# Replicate API token - virtual try-on runs the cuuupid/idm-vton model.
# Get a token at https://replicate.com/account/api-tokens
#
# IMPORTANT: Before the model will run, add credits/payment on this account:
#   https://replicate.com/account/billing
# Each IDM-VTON try-on costs ~$0.023 (about 1 run/credit).
#
# LICENSE WARNING: IDM-VTON is CC BY-NC-SA (NON-COMMERCIAL). It is free to use
# for development/testing, but you must NOT use it in a money-making production
# app. For production, switch to a commercial model/provider first.
REPLICATE_API_TOKEN=r8_your_replicate_token_here
# Max AI try-on generations each user may run per day (cost-control; each run
#   bills the Replicate account ~$0.023). Lower = safer against runaway spend.
AI_TRYON_DAILY_LIMIT=10

