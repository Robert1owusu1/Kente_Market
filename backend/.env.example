
NODE_ENV=development
PORT=5000
TRUST_PROXY=1

# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=branding_house
DB_SSL=0
DB_SSL_CA=

# Auth/Cookies
JWT_SECRET=
SESSION_SECRET=
COOKIE_SAME_SITE=lax

# Frontend/OAuth callback base URL (comma-separate FRONTEND_URL for multiple allowed origins)
FRONTEND_URL=http://localhost:5173
OAUTH_CALLBACK_URL=http://localhost:5000

# OAuth Providers
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Payments
PAYSTACK_SECRET_KEY=

# Email
EMAIL_SERVICE=gmail
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=Bonwire Kente <noreply@example.com>
OTP_EXPIRY_MINUTES=10
MAX_OTP_ATTEMPTS=5

# AI Try-on
REPLICATE_API_TOKEN=
AI_TRYON_DAILY_LIMIT=10

# Marketplace business config
PLATFORM_FEE_RATE=0.1
ESCROW_RELEASE_DAYS=7
